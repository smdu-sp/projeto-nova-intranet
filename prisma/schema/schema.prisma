// Prisma schema – MySQL
// https://pris.ly/d/mysql

generator client {
  provider = "prisma-client-js"
  output = "../generated"
}

datasource db {
  provider = "mysql"
}

model Coordenadoria {
  id           String    @id @default(uuid())
  nome         String    @db.VarChar(120)
  ativo        Boolean   @default(true)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @default(now()) @updatedAt

  usuarios Usuario[]
  reservas Reserva[]
  solicitacoesAcesso HdSolicitacaoAcesso[]

  @@map("principal.coordenadorias")
}

/// Papel operacional do usuário (help desk e administração legada).
enum PapelUsuario {
  DEV
  ADM
  TEC
  SUP
  PAT
  USR
}

model Usuario {
  id              String    @id @default(uuid())
  nome            String
  nomeSocial      String?
  login           String    @unique
  email           String    @unique
  permissao       PapelUsuario @default(USR)
  status          Boolean   @default(true)
  avatar          String?   @db.Text
  coordenadoriaId String?
  desenvolvedor   Boolean   @default(false)

  telefone      String?   @db.VarChar(30)
  ultimoLogin   DateTime  @default(now())
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @default(now()) @updatedAt

  coordenadoria Coordenadoria?   @relation(fields: [coordenadoriaId], references: [id], onDelete: SetNull)
  reservas      Reserva[]
  participacoes ReservaParticipante[]
  avaliacoes    Avaliacao[] @relation("avaliador")

  hdSolicitanteChamados HdChamado[]          @relation("hdSolicitanteChamados")
  hdAbertoEmNomeDe      HdChamado[]          @relation("hdAbertoEmNomeDe")
  hdChamadoUsuarios     HdChamadoUsuario[]   @relation("hdChamadoUsuarios")
  hdAutorEventos        HdChamadoEvento[]    @relation("hdAutorEventos")
  hdAutorMensagens      HdMensagem[]         @relation("hdAutorMensagens")
  hdAutorAnexos         HdAnexo[]            @relation("hdAutorAnexos")
  hdAutorEncaminhamentos HdChamadoEncaminhamento[] @relation("hdAutorEncaminhamentos")
  hdServidorItens       HdItemPatrimonio[]   @relation("hdServidorItens")
  hdTransferencias      HdTransferenciaCabecalho[] @relation("hdUsuarioTransferencias")
  hdBaixasPatrimonio    HdBaixaPatrimonio[]        @relation("hdUsuarioBaixas")
  hdStatusPatrimonio    HdItemPatrimonioStatusHistorico[] @relation("hdUsuarioStatusPatrimonio")
  hdPontoFocalUnidades  HdPontoFocalUnidade[]             @relation("hdPontoFocalUnidades")
  hdBeneficiarioAcesso  HdSolicitacaoAcesso[]             @relation("hdBeneficiarioAcesso")
  hdNegadorAcesso       HdSolicitacaoAcesso[]             @relation("hdNegadorAcesso")
  permissoes    UsuarioPermissao[]
  gpImportadorCargas    GpCargaMensal[]                   @relation("gpImportadorCargas")
  gpUnidades            GpUsuarioUnidade[]                @relation("gpUsuarioUnidades")

  assinaturaPerfil       AssinaturaPerfil?
  invEquipamentos        InvEquipamento[]      @relation("invServidorEquipamentos")
  invColetaSolicitacoes  InvColetaSolicitacao[] @relation("invSolicitanteColeta")
  ttServidor             TtServidor?            @relation("ttServidorUsuario")
  ttUsuarioUnidades      TtUsuarioUnidade[]     @relation("ttUsuarioUnidades")
  ttRegistrosValidados   TtRegistroDiario[]     @relation("ttRegistroValidador")
  ttRegistrosDevolvidos  TtRegistroDiario[]     @relation("ttRegistroDevolvedor")
  ttRegistrosExcluidos   TtRegistroDiario[]     @relation("ttRegistroExcluidor")
  ttFechamentosAutor     TtFechamentoMensal[]   @relation("ttFechamentoAutor")
  ttFechamentosReabertura TtFechamentoMensal[]  @relation("ttFechamentoReabertura")
  ttRelatoriosEmitidos   TtRelatorioEmitido[]   @relation("ttRelatorioAutor")
  ttAuditLogsAtor        TtAuditLog[]           @relation("ttAuditAtor")

  @@map("principal.usuarios")
}

enum Modulo {
  reserva_salas
  avaliacao_limpeza
  gestao_pessoas
  assinatura_email
  teletrabalho
}

model Permissao {
  id             String    @id @default(uuid())
  nome           String    @db.VarChar(50) //modulo.categoria.acao - exemplo: reserva_sala.sala_reserva.criar
  descricao      String?   @db.Text
  modulo         Modulo

  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @default(now()) @updatedAt

  usuarios       UsuarioPermissao[]

  @@map("principal.permissoes")
}

model UsuarioPermissao {
  usuarioId      String
  permissaoId    String

  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @default(now()) @updatedAt

  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permissao      Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, permissaoId])
  @@map("principal.usuario_permissoes")
}