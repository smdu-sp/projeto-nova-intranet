DATABASE_PORT=3306
DATABASE_USER=seu_usuario
DATABASE_PASSWORD=sua_senha
DATABASE_NAME=nome_do_banco

# Ambiente
ENVIRONMENT=development # Para rodar localmente, trocar para "local" no lugar de "development"